{
  "name": "noulette",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "bun test",
    "build": "bun run ./scripts/build-dist.ts",
    "build:dist": "bun run ./scripts/build-dist.ts",
    "build:engine": "bun run ./scripts/build-sidecar.ts",
    "lock:tests": "bun run ./scripts/lock-tests.ts",
    "fixtures": "bun run ./scripts/make-fixtures.ts"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^22.7.5",
    "bun-types": "1.4.2",
    "typescript": "^5.6.3"
  }
}
